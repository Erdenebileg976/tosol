datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ServiceRent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String
  password     String
  type         String
  categories   String[]

  workerGroups WorkerGroup[]

  createdAt    DateTime @default(now())
}

model WorkerGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?

  serviceId   String   @db.ObjectId
  service     ServiceRent @relation(fields: [serviceId], references: [id])

  workers     Worker[]

  createdAt   DateTime @default(now())
}

model Worker {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  role        String

  groupId     String   @db.ObjectId
  group       WorkerGroup @relation(fields: [groupId], references: [id])

  isAvailable Boolean  @default(true)

  createdAt   DateTime @default(now())
}